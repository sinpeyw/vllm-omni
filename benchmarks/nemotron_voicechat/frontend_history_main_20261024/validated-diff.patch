+        "accumulate_full_payload_output",
+        lambda self, rid, payload, request: accumulated.update({rid: payload}),
+    )
+    monkeypatch.setattr(GPUARModelRunner, "_process_additional_information_updates", lambda *args, **kwargs: None)
+
